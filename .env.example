# ROLE=bot (default): the main machine running the Discord bridge.
# ROLE=llm-relay: a machine (e.g. the Pi) that only serves /internal/local-llm
#                 for a remote ROLE=bot instance to call. No Discord login.
ROLE=bot

DISCORD_TOKEN=
GUILD_ID=
CHANNEL_ID=
PORT=7125

# Local model routing (easy requests -> qwen3.5:9b via Ollama)
# On ROLE=bot, when the model runs on a different machine, set LOCAL_LLM_URL
# to that machine's LAN address, e.g. http://192.168.1.50:7125
# On ROLE=llm-relay, LOCAL_LLM_URL is unused (this machine IS the model host).
LOCAL_LLM_URL=http://127.0.0.1:7125
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=120000
LOCAL_LLM_MAX_PROMPT_CHARS=8000
