diff --git a/src/index.ts b/src/index.ts
index b51308c..44e8873 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -1,8 +1,9 @@
-import { Client, GatewayIntentBits } from 'discord.js';
-import type { TextChannel } from 'discord.js';
+import { Client, GatewayIntentBits, ChannelType, PermissionFlagsBits } from 'discord.js';
+import type { TextChannel, Guild } from 'discord.js';
 import express from 'express';
 import dotenv from 'dotenv';
 import { createServer } from 'http';
+import { buildWelcomeEmbed } from './welcomeMessage.js';
 
 dotenv.config();
 
@@ -48,9 +49,59 @@ const client = new Client({
         GatewayIntentBits.Guilds,
         GatewayIntentBits.GuildMessages,
         GatewayIntentBits.MessageContent,
+        // Required to receive guildMemberAdd events. This is a "privileged
+        // intent" — it must also be turned on for this bot in the Discord
+        // Developer Portal under Bot > Privileged Gateway Intents >
+        // "Server Members Intent", or the bot will fail to log in once
+        // requested here.
+        GatewayIntentBits.GuildMembers,
     ],
 });
 
+/**
+ * Finds a channel in the guild the bot can actually post the welcome
+ * message to: the configured system channel if usable, otherwise the
+ * first text channel where the bot has SendMessages permission.
+ */
+function findWelcomeChannel(guild: Guild): TextChannel | null {
+    const canPostHere = (channel: TextChannel) =>
+        channel.permissionsFor(guild.members.me!)?.has(PermissionFlagsBits.SendMessages);
+
+    if (guild.systemChannel && canPostHere(guild.systemChannel)) {
+        return guild.systemChannel;
+    }
+
+    const fallback = guild.channels.cache.find(
+        (c): c is TextChannel => c.type === ChannelType.GuildText && canPostHere(c as TextChannel)
+    );
+    return fallback ?? null;
+}
+
+// Post the welcome message when the bot is added to a new server.
+client.on('guildCreate', async (guild) => {
+    try {
+        const channel = findWelcomeChannel(guild);
+        if (!channel) {
+            console.warn(`[Discord] Joined "${guild.name}" but found no channel to post the welcome message in.`);
+            return;
+        }
+        await channel.send({ embeds: [buildWelcomeEmbed()] });
+    } catch (error) {
+        console.error(`[Discord] Failed to send welcome message in guild ${guild.id}:`, error);
+    }
+});
+
+// DM the welcome message to each new member of a server the bot is in.
+client.on('guildMemberAdd', async (member) => {
+    if (member.user.bot) return;
+    try {
+        await member.send({ embeds: [buildWelcomeEmbed()] });
+    } catch (error) {
+        // Most common cause: the member has server/DMs from strangers disabled.
+        console.warn(`[Discord] Could not DM welcome message to ${member.user.tag}:`, error);
+    }
+});
+
 
 client.on('clientReady', async () => {
     console.log(`Logged in as ${client.user?.tag}!`);
diff --git a/src/welcomeMessage.ts b/src/welcomeMessage.ts
new file mode 100644
